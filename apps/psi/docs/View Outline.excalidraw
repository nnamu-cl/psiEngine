      "updated": 1776475601432,
      "link": null,
      "locked": false,
      "text": "class ImageViewerPanel {\n    std::shared_ptr<GpuTexture> texture;\n    VkDescriptorSet imguiHandle;          // from AddTexture\n    void draw() {\n        ImGui::Begin(\"Viewer\");\n        auto avail = ImGui::GetContentRegionAvail();\n        // compute aspect-preserving fit here\n        ImGui::Image((ImTextureID)imguiHandle, fittedSize);\n        ImGui::End();\n    }\n};",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class ImageViewerPanel {\n    std::shared_ptr<GpuTexture> texture;\n    VkDescriptorSet imguiHandle;          // from AddTexture\n    void draw() {\n        ImGui::Begin(\"Viewer\");\n        auto avail = ImGui::GetContentRegionAvail();\n        // compute aspect-preserving fit here\n        ImGui::Image((ImTextureID)imguiHandle, fittedSize);\n        ImGui::End();\n    }\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
